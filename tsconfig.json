{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["ES2017", "DOM"],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "rootDir": "docs/src",
    "outDir": "docs",
    "newLine": "lf",
    "removeComments": false
  },
  "include": ["docs/src/*.ts"],
  "exclude": ["node_modules"]
}
